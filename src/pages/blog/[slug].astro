---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { SITE } from "../../data/site";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<"blog">; }
const { post } = Astro.props;
const { title, description, date, image, imageAlt, youtube } = post.data;
const { Content } = await render(post);

// Accepts youtube.com/watch?v=, youtu.be/, /shorts/ and /embed/ links
const youtubeId = youtube.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([\w-]{11})/)?.[1];

const url = new URL(`/blog/${post.id}`, SITE.url).href;
const postLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  mainEntityOfPage: url,
  image: image ? new URL(image, SITE.url).href : undefined,
  author: { "@type": "Organization", name: SITE.name, url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
};
---
<Base title={title} description={description} image={image || undefined} type="article" jsonLd={postLd}>
  <article>
    <header class:list={["article-hero textured", { "no-cover": !image }]}>
      <div class="wrap">
        <a class="back" href="/blog">← All posts</a>
        <p class="eyebrow"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></p>
        <h1>{title}</h1>
      </div>
    </header>
    <div class:list={["article", { "no-cover": !image }]}>
      {image && <figure class="cover" style="margin-bottom:0"><img src={image} alt={imageAlt} width="1200" height="675" /></figure>}
      {youtubeId && (
        <div class="video-embed">
          <div><iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
        </div>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <Cta />
</Base>
