---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="page-hero textured" style="border-bottom:0; min-height:60vh">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page didn't rank.</h1>
      <p class="lede">The page you're looking for doesn't exist or has moved.</p>
      <p style="margin-top:32px; display:flex; flex-wrap:wrap; gap:12px">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-ghost" href="/blog">Read the blog</a>
      </p>
    </div>
  </section>
</Base>
