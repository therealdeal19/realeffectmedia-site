---
import Base from "../layouts/Base.astro";
---
<Base title="Thanks" description="We got your consultation request." noindex>
  <section class="page-hero textured" style="border-bottom:0; min-height:60vh">
    <div class="wrap">
      <p class="eyebrow">Request received</p>
      <h1>Thanks. We'll be in touch.</h1>
      <p class="lede">We'll email you within one business day to set up your free consultation. In the meantime, see what we've been posting.</p>
      <p style="margin-top:32px; display:flex; flex-wrap:wrap; gap:12px">
        <a class="btn btn-primary" href="/blog">Read the blog</a>
        <a class="btn btn-ghost" href="/">Back to home</a>
      </p>
    </div>
  </section>
</Base>
