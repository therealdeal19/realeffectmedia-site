---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import PostCard from "../../components/PostCard.astro";
import VideoCarousel from "../../components/VideoCarousel.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base
  title="Blog"
  description="The Real Effect Media playbook: how real estate agents use YouTube and SEO to generate their own leads."
>
  <section class="page-hero textured">
    <div class="wrap">
      <p class="eyebrow">The playbook</p>
      <h1>How agents win on YouTube.</h1>
      <p class="lede">Strategy, examples and what's working right now for real estate agents building their own lead source.</p>
    </div>
  </section>

  <section class="list-sec">
    <div class="wrap">
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <VideoCarousel />
    </div>
  </section>

  <Cta />
</Base>
